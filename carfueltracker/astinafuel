#!/bin/sh
DIR=/mnt/carfueltracker
PORT=8001

cd "$DIR" || {
  echo "AstinaFuel directory not available: $DIR"
  echo "Mount the iOS/iCloud folder first if required."
  exit 1
}

echo ""
echo "ASTINAFUEL — LOCAL UPDATE SERVER"
echo "Directory : $DIR"
echo "URL       : http://127.0.0.1:$PORT"
echo ""
echo "Use this only for install/update."
echo "Press Ctrl+C to stop."
echo ""

exec python3 -m http.server "$PORT" --bind 127.0.0.1
